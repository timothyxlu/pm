{
  "name": "pm",
  "version": "1.0.0",
  "description": "Personal project tracker on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev --local-upstream localhost:8787",
    "db:migrate:local": "wrangler d1 migrations apply pm --local",
    "db:migrate": "wrangler d1 migrations apply pm --remote",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p .",
    "token:create": "node scripts/create-token.mjs",
    "smoke": "bash scripts/smoke.sh",
    "smoke:oauth": "node scripts/oauth-smoke.mjs",
    "build": "vite build",
    "dev:web": "vite"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.59.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.166.0"
  },
  "private": true,
  "type": "module"
}
