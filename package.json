{
  "name": "pm",
  "version": "1.0.0",
  "description": "Personal project tracker on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply pm --local",
    "db:migrate": "wrangler d1 migrations apply pm --remote",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p .",
    "token:create": "node scripts/create-token.mjs",
    "smoke": "bash scripts/smoke.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.166.0"
  },
  "private": true,
  "type": "module"
}
