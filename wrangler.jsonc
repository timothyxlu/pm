{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pm",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // The *.workers.dev URL would skip Cloudflare Access, so keep it off.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "pm.timothyxlu.xyz", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/login", "/api/*", "/mcp", "/webhooks/*", "/authorize", "/oauth/*", "/.well-known/*"]
  },
  // database_id and the KV id are filled in at deploy by scripts/resolve-resources.sh.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pm",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
  "vars": {
    "PUBLIC_URL": "https://pm.timothyxlu.xyz",
    // Zero Trust team domain, e.g. "timothyxlu.cloudflareaccess.com"
    "ACCESS_TEAM_DOMAIN": "polished-cloud-d24f.cloudflareaccess.com",
    // AUD tag of the Access application that covers pm.timothyxlu.xyz
    "ACCESS_AUD": "ce670577fb261bfba0c12071cef432bd361b1b59793e4a83f3d655994b50abec"
  },
  "observability": { "enabled": true }
}
